{
  "name": "tonikakuyare",
  "version": "1.0.0",
  "private": true,
  "description": "仕事中に指定したサイトへのアクセスをブロックするブラウザ拡張",
  "scripts": {
    "prettier": "prettier **/*.{md,html,json} -w",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "build:clean": "rm -rf dist",
    "build:zip": "mkdir -p dist && cd work-focus && zip -r ../dist/work-focus.zip . -x '*.DS_Store'",
    "build:xpi": "cp dist/work-focus.zip dist/work-focus.xpi",
    "build": "npm run build:clean && npm run build:zip && npm run build:xpi"
  },
  "license": "Apache 2.0",
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "eslint": "9.19.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.4.1",
    "globals": "15.14.0",
    "prettier": "3.3.3"
  }
}
